{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "revisions": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "repository",
          "commit_sha"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "revisions"
  ],
  "additionalProperties": false,
  "$id": "urn:proofgate:schema:revisions:1",
  "title": "Revision set"
}
